From c834b9d79c9b05cfd99c1715f8bd043c7124031a Mon Sep 17 00:00:00 2001
From: "Marcelo M. Maciel" <4993482+marcelo-maciel@users.noreply.github.com>
Date: Tue, 21 Jul 2026 06:00:49 -0300
Subject: [PATCH 33/77] fix(deps): pin System.Security.Cryptography.Xml to
 10.0.10

The test hosts pull 10.0.8 transitively, which carries HIGH-severity
advisories (GHSA-23rf-6693-g89p, GHSA-8q5v-6pqq-x66h, GHSA-cvvh-rhrc-wg4q,
GHSA-g8r8-53c2-pm3f) and trips NuGetAudit under TreatWarningsAsErrors,
breaking the build of every test project. 10.0.10 is the patched
servicing release. Mirrors the existing Microsoft.OpenApi transitive pin.
---
 src/Directory.Packages.props | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/Directory.Packages.props b/src/Directory.Packages.props
index b1567ac911..0d232beb2e 100644
--- a/src/Directory.Packages.props
+++ b/src/Directory.Packages.props
@@ -104,6 +104,11 @@
          trips NuGetAudit under TreatWarningsAsErrors. Stay on the 2.x line — 3.x has breaking API changes that
          fail the framework's OpenAPI transformers. Bump in lockstep with Microsoft.AspNetCore.OpenApi. -->
     <PackageVersion Include="Microsoft.OpenApi" Version="2.9.0" />
+    <!-- Pin the transitive System.Security.Cryptography.Xml explicitly. The test hosts pull 10.0.8 transitively,
+         which carries HIGH-severity advisories (GHSA-23rf-6693-g89p, GHSA-8q5v-6pqq-x66h, GHSA-cvvh-rhrc-wg4q,
+         GHSA-g8r8-53c2-pm3f) that trip NuGetAudit under TreatWarningsAsErrors. 10.0.10 is the patched servicing
+         release. Bump in lockstep with the .NET 10 servicing band. -->
+    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
     <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
     <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
     <PackageVersion Include="Shouldly" Version="4.3.0" />

