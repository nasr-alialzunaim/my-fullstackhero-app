 clients/dashboard/tests/helpers/auth-seed.ts  | 75 +++++++++++++++++-
 clients/dashboard/tests/i18n/switcher.spec.ts | 76 ++++++++++++++++++-
 .../impersonation/impersonation-ended.spec.ts | 51 ++-----------
 4 files changed, 167 insertions(+), 50 deletions(-)

